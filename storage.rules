rules_version = '2';

// Coffee Times Cloud Storage rules.
//
// Deploy with:  firebase deploy --only storage
//
// Keep this file as the source of truth. Editing rules only in the Firebase
// console is what allowed the CMS upload path to go unnoticed: the rules
// granted writes to `businesses/{userId}/**` while the CMS has always uploaded
// to `listings/...`, so every upload was denied with `storage/unauthorized`
// and surfaced as "Failed to upload images".

service firebase.storage {
  match /b/{bucket}/o {

    // Reusable predicates -----------------------------------------------

    // On a delete, `request.resource` is null, so the size/type checks must be
    // skipped or the whole rule errors out and deletion is denied.
    function isDelete() {
      return request.resource == null;
    }

    // 25MB matches MAX_FILE_SIZE_MB in components/image-upload.tsx. The CMS
    // offers to compress anything over 1MB before it is uploaded, but an admin
    // may deliberately choose "Upload original" for artwork where fidelity
    // matters — that must not then fail server-side. Keep the two in step.
    function isValidImage() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // CMS listing images -------------------------------------------------
    // Written by signed-in CMS admins. Public read, because the Ionic and React
    // Native apps render these images without authenticating.
    match /listings/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (isDelete() || isValidImage());
    }

    // Category artwork ---------------------------------------------------
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (isDelete() || isValidImage());
    }

    // Advert images ------------------------------------------------------
    match /ADS/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (isDelete() || isValidImage());
    }

    // Legacy Ionic app path ----------------------------------------------
    // This was `allow read, write: if true` — writable and deletable by anyone
    // on the internet. On a Blaze plan the practical risk was bill inflation:
    // a stranger could fill the bucket. Closed 2026-08-15.
    //
    // The prefix is empty (bucket top level holds only ADS/, accounting/,
    // categories/ and listings/) and the CMS never writes here, so denying
    // writes breaks nothing that currently works. Reads stay open in case the
    // live Ionic app references old URLs.
    //
    // If the Ionic app does need to write here, scope it rather than reopening:
    //   allow write: if isSignedIn() && request.auth.uid == userId
    //                && (isDelete() || isValidImage());
    match /businesses/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied by default.
  }
}
